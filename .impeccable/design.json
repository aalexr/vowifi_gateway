      "html": "<label class=\"ds-label\">SMSC<input class=\"ds-input\" value=\"+16475800172\"></label><div class=\"ds-hint\">Read from EF_SMSP.</div>",
      "css": ".ds-label{font-family:\"Adwaita Sans\",ui-sans-serif,system-ui,sans-serif;display:block;font-size:12px;font-weight:500;color:var(--text-dim,#71717a);}.ds-input{display:block;margin-top:4px;width:100%;font-family:\"Adwaita Sans\",ui-sans-serif,system-ui,sans-serif;font-size:14px;padding:8px 10px;border-radius:9px;border:1px solid var(--border-strong,#d4d4d8);background:var(--input-bg,#fff);color:var(--text,#09090b);outline:none;}.ds-input:focus{border-color:var(--primary,#4f46e5);box-shadow:0 0 0 3px color-mix(in srgb,#4f46e5 40%,transparent);}.ds-hint{font-family:\"Adwaita Sans\",ui-sans-serif,system-ui,sans-serif;font-size:12px;line-height:1.5;color:var(--text-mute,#a1a1aa);margin-top:6px;}"
    },
