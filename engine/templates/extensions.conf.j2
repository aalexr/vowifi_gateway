{% set local_eps = [] %}
{% for acct in external_accounts %}{% set _ = local_eps.append('PJSIP/' ~ acct.username) %}{% endfor %}
{% if webrtc_enable %}{% set _ = local_eps.append('PJSIP/' ~ webrtc_user) %}{% endif %}
{% set dialstr = local_eps | join('&') %}
{% set msg_targets = [] %}
{% for acct in external_accounts %}{% set _ = msg_targets.append(acct.username) %}{% endfor %}
{% if webrtc_enable %}{% set _ = msg_targets.append(webrtc_user) %}{% endif %}

; ===== Incoming call from the IMS/VoWiFi side =====
[volte_ims]
; MUST be _. (match anything): the IMS routes inbound calls to our REGISTERED CONTACT, whose
; user part is a random GRUU/UUID (e.g. ef666c87-...@[v6]:port), NOT a phone number — so a
; numeric-only pattern like _[+0-9]. never matches and every incoming call is 404-rejected.
; The explicit h/i/t handlers below take precedence over _. , so no phantom "call to h" is
; logged (that was the original reason _. had been narrowed).
exten => _.,1,NoOp(Incoming call from ${CALLERID(num)})
same => n,Set(CALLPEER=${CALLERID(num)})
; Codec log (call log + SIM Config "seen from the carrier"): the carrier's offer as it came in
; the INVITE, every codec the network accepts. Read now, before a re-offer in the PRACK/UPDATE
; (MTS re-offers just the chosen codec) replaces it. Values are sanitised by chan_pjsip.
same => n,Set(CARRIER_SDP=${CHANNEL(pjsip,remote_sdp_codecs)})
same => n,Set(CARRIER_BW=${CHANNEL(pjsip,remote_sdp_bw)})
same => n,Progress()
same => n,TrySystem(/usr/local/bin/notify.py call_in "${CALLERID(num)}" &)
same => n,WaitForPrecondition(10,2000)
same => n,Ringing()
{% if dialstr %}
same => n,Dial({{ dialstr }},60,b(local_offer^s^1)U(codec_mt_answered^s^1))
same => n,GotoIf($["${DIALSTATUS}" = "ANSWER"]?done)
; Not answered: give the carrier the final response a phone would. Declined on a local client
; (603 -> Q.850 21) or busy -> cause 17 = 486 Busy Here; unanswered / no client reachable ->
; cause 19 = 480 Temporarily Unavailable. Without this the reject cause 21 maps to
; 403 Forbidden, which carriers may announce as "call not allowed".
same => n,Hangup(${IF($["${DIALSTATUS}" = "BUSY" | "${HANGUPCAUSE}" = "21"]?17:19)})
{% else %}
same => n,Answer()
same => n,Wait(30)
{% endif %}
same => n(done),Hangup()
; i (invalid) / t (response timeout) are explicit no-ops so the broad _. never mislogs them.
exten => i,1,Hangup()
exten => t,1,Hangup()
; The hangup handler ALWAYS runs (whether the caller hangs up unanswered, we decline, or the
; call completes), so the "ringing" record is finalized to a real disposition here instead of
; only after Dial() (which is skipped when the inbound leg is torn down first).
; CRITICAL: after priority 1 Asterisk auto-increments to h,2 which does NOT exist, so it would
; FALL THROUGH to the broad `_.` pattern (priorities 2-9: Set/Progress/call_in/Dial…) and fire
; a phantom SECOND `call_in` (+ a stray Dial) for every call — leaving a ghost 'ringing' row in
; the call log. Hangup() at h,2 ends the 'h' extension so no fall-through happens. (Not Return():
; 'h' runs as a plain extension, not via Gosub, so Return() logs "Return without Gosub: stack is
; unallocated" as an ERROR on every call, although it stops execution just the same.)
; MEDIA (base64, see [codec_mt_answered]): our final answer to the carrier, read here so it
; includes a PRACK/UPDATE re-negotiation.
exten => h,1,Set(MEDIA=rs=${CARRIER_SDP}&bw=${CARRIER_BW}&ls=${CHANNEL(pjsip,local_sdp_codecs)}&cl=${CLIENT_SDP})
same => n,TrySystem(/usr/local/bin/notify.py call_result in "${CALLPEER}" "${DIALSTATUS}" "${HANGUPCAUSE}" "${BASE64_ENCODE(${MEDIA})}" &)
same => n,Hangup()

; Dial U() subroutines: run on the answered callee channel, record its negotiated SDP on the
; calling channel (MASTER_CHANNEL) for the 'h' handler's call_result. rs/ls = the carrier
; leg's remote/local SDP codecs (after an answer pjmedia has narrowed the local one to the
; negotiated codecs, so an outgoing call's ls is not the full offer), bw = its b= lines,
; cl = the local client's answer.
; Pre-dial handler on each local client leg (Dial b()): offer the client our codec order,
; Opus first. Without it chan_pjsip offers in the carrier channel's order (G722, AMR, opus …)
; and the FRITZ!Box picks G722; codec_prefs_outgoing_offer does not change that. Same list as
; endpoint-local in pjsip.conf; a browser ignores the AMR it doesn't know.
[local_offer]
exten => s,1,Set(PJSIP_MEDIA_OFFER(audio)=opus,g722,ulaw,alaw,amr)
same => n,Return()

[codec_mt_answered]
exten => s,1,Set(MASTER_CHANNEL(CLIENT_SDP)=${CHANNEL(pjsip,remote_sdp_codecs)})
same => n,Return()

[codec_mo_answered]
exten => s,1,Set(MASTER_CHANNEL(CARRIER_SDP)=${CHANNEL(pjsip,remote_sdp_codecs)})
same => n,Set(MASTER_CHANNEL(CARRIER_BW)=${CHANNEL(pjsip,remote_sdp_bw)})
same => n,Set(MASTER_CHANNEL(OUR_SDP)=${CHANNEL(pjsip,local_sdp_codecs)})
same => n,Return()

; ===== Incoming SMS from the IMS/VoWiFi side =====
[volte_ims_msg]
; Submit report for one of our MO SMS (res_pjsip_messaging VOWIFI_SMS_REPORT): the SMSC's
; RP-ACK/RP-ERROR, or a SIP failure / "not registered" for the MO MESSAGE itself. Not a text:
; hand the verdict to the manager and don't forward it to local clients.
exten => _.,1,GotoIf($["${MESSAGE_DATA(SMS_REPORT)}" != ""]?report)
same => n,NoOp(Incoming SMS from ${MESSAGE(from)})
; SMS_CONCAT ("ref:total:seq", set by res_pjsip_messaging from the UDH) marks one part of a
; concatenated SMS; the manager joins the parts. Empty for a single-part SMS.
same => n,TrySystem(/usr/local/bin/notify.py sms_in "${MESSAGE(from)}" "${BASE64_ENCODE(${MESSAGE(body)})}" "${MESSAGE_DATA(SMS_CONCAT)}" &)
{% for t in msg_targets %}
same => n,MessageSend(pjsip:{{ t }},${MESSAGE(from)},sip:{{ t }})
{% endfor %}
same => n,Hangup()
; A non-SMS MESSAGE turns its SIP headers into variables, so SMS_REPORT* could be forged: only
; the known kinds pass, numbers are FILTERed and the free-text reason goes base64-encoded, so
; nothing from the network reaches the shell of TrySystem as-is.
same => n(report),Set(KIND=${MESSAGE_DATA(SMS_REPORT)})
same => n,GotoIf($["${KIND}" = "ack" | "${KIND}" = "error" | "${KIND}" = "sip"]?:done)
same => n,TrySystem(/usr/local/bin/notify.py sms_report ${KIND} "${FILTER(0123456789,${MESSAGE_DATA(SMS_REPORT_REF)})}" "${FILTER(0123456789,${MESSAGE_DATA(SMS_REPORT_CAUSE)})}" "${FILTER(0123456789,${MESSAGE_DATA(SMS_REPORT_SIP_STATUS)})}" "${BASE64_ENCODE(${MESSAGE_DATA(SMS_REPORT_REASON)})}" &)
same => n(done),Hangup()

; ===== Outgoing call from a local endpoint (softphone / external SIP) =====
; Single dial attempt (no auto-redial). The dial result (incl. far-end reject) is
; reported to the manager for the call log.
[from-local]
; _[+0-9]. (not _.) so the special h/i/t extensions never match here and log phantom calls
{% set dest = '${DEST}' if dial_00_to_plus else '${EXTEN}' %}exten => _[+0-9].,1,NoOp(Outgoing call to ${EXTEN} from ${CALLERID(num)})
{% if dial_00_to_plus %}; Per-line dial_00_to_plus: send a leading international prefix 00 as "+" (E.164), for
; carriers that don't treat 00 as international (MTS RU uses 8~10 / +) while local phones
; such as FRITZ!Box DECT handsets can't dial "+".
same => n,Set(DEST=${IF($["${EXTEN:0:2}" = "00"]?+${EXTEN:2}:${EXTEN})})
{% endif %}same => n,Set(CALLPEER={{ dest }})
same => n,TrySystem(/usr/local/bin/notify.py call_out "{{ dest }}" &)
; Ring timeout {{ ring_timeout }}s (configurable): if the callee never answers, Asterisk
; CANCELs the outbound INVITE at this deadline instead of leaving it open. The carrier keeps
; the early dialog alive and RE-ALERTS the callee (repeated 180 Ringing) for as long as our
; INVITE is pending, so a shorter timeout bounds how many ring cycles the callee gets before
; we give up. Most carriers roll to voicemail by ~30s; 35 is the default. (The repeated
; ringing itself is carrier-side MMTel behaviour and can't be removed here.) A caller who
; hangs up earlier still CANCELs immediately.
same => n,Dial(PJSIP/{{ dest }}@volte_ims,{{ ring_timeout }},U(codec_mo_answered^s^1))
; Dial only returns here when the call was NEVER answered (reject/busy/no-answer/congestion);
; answered calls are bridged and tear down via BYE, never reaching this line.
; Save the REAL disposition for the call log BEFORE overriding the response (PJSIPHangup does
; not clobber HANGUPCAUSE, but Set them first so the 'h' handler is order-independent).
same => n,Set(REALSTATUS=${DIALSTATUS})
same => n,Set(REALCAUSE=${HANGUPCAUSE})
; CRITICAL: on a rejected/unavailable call the carrier (Telus IMS) returns "480 Temporarily
; Unavailable", which Asterisk forwards to the local caller. 480 is a RETRYABLE response
; (RFC 3261 §21.4.11), so MicroSIP auto-redials forever and JsSIP hangs. Force a clean,
; non-retryable "603 Decline" to the caller instead so the client stops and shows the call as
; ended/declined. (ANSWER never reaches here; the guard is belt-and-suspenders.)
same => n,ExecIf($["${DIALSTATUS}" != "ANSWER"]?PJSIPHangup(Decline))
same => n,Hangup()
; Report the outcome from the hangup handler, NOT inline after Dial(): when the caller
; (softphone) hangs up mid-ring, the caller channel is destroyed and jumps straight to 'h',
; so an inline call_result would never run and the record would stay stuck on "dialing".
; Use REALSTATUS/REALCAUSE (captured right after Dial) so the log keeps the TRUE far-end
; disposition (e.g. CHANUNAVAIL/31) rather than the overridden Decline; fall back to the live
; vars when REAL* are unset (caller hung up mid-ring → jumped straight to 'h' before Set).
exten => h,1,Set(ST=${IF($["${REALSTATUS}" != ""]?${REALSTATUS}:${DIALSTATUS})})
same => n,Set(CS=${IF($["${REALCAUSE}" != ""]?${REALCAUSE}:${HANGUPCAUSE})})
same => n,Set(MEDIA=rs=${CARRIER_SDP}&bw=${CARRIER_BW}&ls=${OUR_SDP}&cl=${CHANNEL(pjsip,local_sdp_codecs)})
same => n,TrySystem(/usr/local/bin/notify.py call_result out "${CALLPEER}" "${ST}" "${CS}" "${BASE64_ENCODE(${MEDIA})}" &)
same => n,Hangup()

; ===== Outgoing SMS from a local endpoint =====
[msg-from-local]
exten => _.,1,NoOp(Outgoing SMS to ${MESSAGE(to)})
same => n,Set(EXTEN=${CUT(CUT(MESSAGE(to),@,1),:,2)})
same => n,TrySystem(/usr/local/bin/notify.py sms_out "${EXTEN}" "${BASE64_ENCODE(${MESSAGE(body)})}" &)
same => n,MessageSend(pjsip:volte_ims/${EXTEN}@volte_ims,sip:{{ msisdn }}@{{ realm }},sip:${EXTEN}@volte_ims)
